#!/usr/bin/env bash

# Repair the Let’s Encrypt configuration of an already installed edulution
# instance. This is only needed for installations affected by the former
# EDULUTION_DIRECTORY host-path bug in the curl installer.
set -Eeuo pipefail

DIRECTORY="/srv/docker/edulution-ui"
ENVIRONMENT_FILE="${DIRECTORY}/edulution.env"
LE_TEMPLATE="${DIRECTORY}/edulution-default-le.yml"
TRAEFIK_CONFIG="${DIRECTORY}/traefik.yml"
DYNAMIC_CONFIG="${DIRECTORY}/data/traefik/config/edulution-default.yml"
SSL_DIRECTORY="${DIRECTORY}/data/traefik/ssl"

info() {
  printf '[*] %s\n' "$*"
}

fatal() {
  printf '[!] %s\n' "$*" >&2
  exit 1
}

if [ "$EUID" -ne 0 ]; then
  fatal "Bitte mit Root-Rechten ausführen, z.B. mit 'sudo bash'."
fi

for command in curl jq docker; do
  command -v "$command" >/dev/null 2>&1 || fatal "Benötigter Befehl fehlt: $command"
done

[ -f "$ENVIRONMENT_FILE" ] || fatal "Keine edulution-Installation unter ${DIRECTORY} gefunden."
[ -f "$LE_TEMPLATE" ] || fatal "Let’s-Encrypt-Vorlage fehlt: ${LE_TEMPLATE}"

# The file was generated by the installer and is intentionally loaded to read
# only the local domain and LE contact address.
source "$ENVIRONMENT_FILE"
: "${EDULUTION_BASE_DOMAIN:?EDULUTION_BASE_DOMAIN fehlt in edulution.env}"
: "${LE_EMAIL:?LE_EMAIL fehlt in edulution.env}"

if ! registration=$(curl --fail --show-error --silent --location --retry 3 \
  --request POST https://acme-dns.netzint.de/register); then
  fatal "ACME-DNS-Registrierung konnte nicht angelegt werden."
fi

acme_target=$(jq -er '.fulldomain' <<<"$registration") \
  || fatal "ACME-DNS lieferte keine gültige Registrierung."

mkdir -p "$SSL_DIRECTORY"
timestamp=$(date +%Y%m%d%H%M%S)
cp -a "$TRAEFIK_CONFIG" "${TRAEFIK_CONFIG}.before-letsencrypt-${timestamp}"
cp -a "$DYNAMIC_CONFIG" "${DYNAMIC_CONFIG}.before-letsencrypt-${timestamp}"

cat > "$TRAEFIK_CONFIG" <<EOF
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: "websecure"
          scheme: "https"
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
        domains:
          - main: "${EDULUTION_BASE_DOMAIN}"
    transport:
      respondingTimeouts:
        readTimeout: 0s
        writeTimeout: 0s
        idleTimeout: 0s
  imap:
    address: ":143"
  imaps:
    address: ":993"

providers:
  file:
    directory: "/etc/traefik/dynamic/"
    watch: true

log:
  level: ERROR

serversTransport:
  insecureSkipVerify: true

ping: {}

certificatesResolvers:
  letsencrypt:
    acme:
      email: ${LE_EMAIL}
      storage: /etc/traefik/ssl/acme.json
      dnsChallenge:
        provider: acme-dns
EOF

escaped_domain=$(printf '%s' "$EDULUTION_BASE_DOMAIN" | sed 's/[\\/&]/\\&/g')
sed -E "s/\{\{[[:space:]]*DOMAIN[[:space:]]*\}\}/${escaped_domain}/g" \
  "$LE_TEMPLATE" > "$DYNAMIC_CONFIG"

printf '{}' > "${SSL_DIRECTORY}/acme.json"
chmod 600 "${SSL_DIRECTORY}/acme.json"
jq --arg domain "$EDULUTION_BASE_DOMAIN" --argjson registration "$registration" \
  '{($domain): $registration}' > "${SSL_DIRECTORY}/acmedns.json"
chmod 600 "${SSL_DIRECTORY}/acmedns.json"

info "Let’s-Encrypt-Konfiguration geschrieben und bestehende Dateien gesichert."
printf '\nErstelle jetzt bei deinem DNS-Provider diesen CNAME-Eintrag:\n\n'
printf '  _acme-challenge.%s  ->  %s\n\n' "$EDULUTION_BASE_DOMAIN" "$acme_target"
printf 'Nach der DNS-Änderung Traefik neu starten:\n\n'
printf '  cd %s && docker compose restart edu-traefik\n' "$DIRECTORY"
