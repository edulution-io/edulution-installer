#!/bin/bash

###########################################################
# Update for an edulution UI installation
# by Netzint GmbH
###########################################################

set -euo pipefail

DIRECTORY="/srv/docker/edulution-ui/"
# Image und Version dieses Skripts. Ein Release ersetzt beide Zeilen durch den veroeffentlichten Digest und seine Version.
EDULUTION_INSTALLER_IMAGE="ghcr.io/edulution-io/edulution-installer:latest"
EDULUTION_INSTALLER_VERSION="dev"
OWN_IMAGE=$EDULUTION_INSTALLER_IMAGE
OWN_VERSION=$EDULUTION_INSTALLER_VERSION
# Test hooks: directory, terminal and root check.
DIRECTORY="${EDULUTION_UPDATE_DIR:-$DIRECTORY}"
DIRECTORY="${DIRECTORY%/}/"
TTY_FILE="${EDULUTION_UPDATE_TTY:-/dev/tty}"
# Set once apply has written the files and removed after the services restarted, so a later run finishes the restart.
# It names the release whose files it wrote.
RESTART_PENDING="${DIRECTORY}.update-restart-pending"
VERSION_GIVEN=0
# Per run, so a --check next to a running update leaves its file alone.
RESOLVED_CONFIG=""
UPDATE_ENV=()

use_version() {
    local version="${1#v}"
    if [[ -z "$version" || "$version" == --* ]]; then
        echo "[!] --version benötigt eine Version, z.B. --version 2.1.0-rc.1"
        exit 2
    fi
    EDULUTION_INSTALLER_IMAGE="ghcr.io/edulution-io/edulution-installer:${version}"
    EDULUTION_INSTALLER_VERSION="${version}"
    echo "Version ${version} wird verwendet (Image ${EDULUTION_INSTALLER_IMAGE})."
}

downgrade_hint() {
    echo "[!] Die Installation ist neuer als dieses Update-Skript (Installer ${EDULUTION_INSTALLER_VERSION}), ein Downgrade wird abgelehnt."
    echo "    Mit --version <X.Y.Z> die Version der Installation oder eine neuere wählen."
}

# Installer images from before the update tool fail with "No module named update" and exit 1.
old_image_hint() {
    local out
    [[ $1 -eq 1 ]] || return 0
    out=$(docker run --rm "$EDULUTION_INSTALLER_IMAGE" python -c "import update" 2>&1) && return 0
    if [[ "$out" == *"No module named"*update* ]]; then
        echo "[!] Das Image ${EDULUTION_INSTALLER_IMAGE} enthält das Update-Werkzeug noch nicht."
        echo "    Mit --version <X.Y.Z> eine neuere Version wählen."
    fi
}

usage() {
    echo "Verwendung: update [--version <X.Y.Z[-rc.N]>] [--check [--json]] [--yes] [--compose-only]"
    echo "              [--discard-local-changes] [--migration <ID>]"
}

# newer <a> <b>: true if release a is newer than release b ("dev" counts as the newest).
newer() {
    local a=${1//-/\~} b=${2//-/\~}
    [[ "$a" != "$b" && $(printf '%s\n' "$a" "$b" | sort -V | tail -n 1) == "$a" ]]
}

# run_image <image> <args...>
run_image() {
    local image=$1 mounts=(-v "${DIRECTORY}:/edulution-ui")
    shift
    # Backups are named after the local time; without the file the container runs on UTC.
    if [[ -e /etc/localtime ]]; then
        mounts+=(-v /etc/localtime:/etc/localtime:ro)
    fi
    docker run --rm "${mounts[@]}" "${UPDATE_ENV[@]}" "$image" python -m update "$@"
}

run_update() {
    run_image "$EDULUTION_INSTALLER_IMAGE" "$@"
}

restart_hint() {
    echo "    docker compose --project-directory ${DIRECTORY} pull && docker compose --project-directory ${DIRECTORY} up -d && rm -f ${RESTART_PENDING}"
}

restart_services() {
    if ! docker compose --project-directory "$DIRECTORY" pull || ! docker compose --project-directory "$DIRECTORY" up -d; then
        echo "[!] Die Dateien wurden aktualisiert, aber das Neustarten der Dienste ist fehlgeschlagen."
        echo "    Ein erneuter Aufruf des Updates versucht es noch einmal, oder von Hand:"
        restart_hint
        echo "    Sicherungen der alten Dateien: ${DIRECTORY}docker-compose-backups/"
        exit 1
    fi
    rm -f "$RESTART_PENDING"
}

# edu-api's environment as Compose resolves it (edulution.env, docker-compose.override.yml, interpolation),
# for the check of the database user. It holds secrets: mktemp creates it readable by root only, and it is
# removed on exit. Handed over in the environment, which images without this check ignore.
resolve_config() {
    UPDATE_ENV=()
    if [[ -z "$RESOLVED_CONFIG" ]]; then
        RESOLVED_CONFIG=$(mktemp "${DIRECTORY}.update-resolved-config.XXXXXX") || { RESOLVED_CONFIG=""; return 0; }
    fi
    if docker compose --project-directory "$DIRECTORY" config --format json > "$RESOLVED_CONFIG" 2>/dev/null \
        && [[ -s "$RESOLVED_CONFIG" ]]; then
        UPDATE_ENV=(-e "EDULUTION_UPDATE_RESOLVED_CONFIG=/edulution-ui/${RESOLVED_CONFIG##*/}")
    else
        : > "$RESOLVED_CONFIG"
    fi
}

# The restart starts what the files describe: a database with a key file needs the user edu-api logs in with.
# The check runs with the newer of this script's release and the one in use, as an older release may lack it;
# the marker stays unless it passes.
check_before_restart() {
    local rc=0 image=$EDULUTION_INSTALLER_IMAGE
    if [[ "$OWN_IMAGE" != "$EDULUTION_INSTALLER_IMAGE" ]] && newer "$OWN_VERSION" "$EDULUTION_INSTALLER_VERSION"; then
        image=$OWN_IMAGE
        if ! docker pull "$image" && ! docker image inspect "$image" >/dev/null 2>&1; then
            echo "[!] Das Image ${image} für die Prüfung vor dem Neustart konnte nicht geladen werden,"
            echo "    der Neustart wird nicht ausgeführt. Ein erneuter Aufruf des Updates versucht es noch einmal."
            exit 1
        fi
    fi
    resolve_config
    run_image "$image" restart-check > /dev/null || rc=$?
    case $rc in
        0) ;;
        6)
            echo "[!] edu-api erhält MONGODB_USERNAME und MONGODB_PASSWORD nicht beide mit Wert, die Datenbank startet"
            echo "    aber mit Zugriffskontrolle. Der Neustart wird nicht ausgeführt. Zuerst einen Datenbank-Benutzer"
            echo "    anlegen und eintragen, dann das Update erneut aufrufen."
            exit 6
            ;;
        *)
            echo "[!] Die Prüfung vor dem Neustart ist fehlgeschlagen (Code ${rc}), der Neustart wird nicht ausgeführt."
            echo "    Ein erneuter Aufruf des Updates versucht es noch einmal."
            exit "$rc"
            ;;
    esac
}

# nothing_written <rc> <token>: true if the failed apply or migrate left the files as they were.
nothing_written() {
    local after
    case $1 in
        # These codes come from checks that run before any file is written.
        2 | 3 | 4 | 5 | 6 | 20 | 30) return 0 ;;
    esac
    after=$(run_update expect 2>/dev/null) && [[ "$after" == "$2" ]]
}

main() {
    # The script's own messages go to stderr and fd 4 keeps stdout for the container's output,
    # so --check --json prints nothing but the JSON on stdout.
    exec 4>&1 1>&2
    trap '[[ -z "$RESOLVED_CONFIG" ]] || rm -f "$RESOLVED_CONFIG"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    CHECK_ONLY=0
    JSON=0
    YES=0
    COMPOSE_ONLY=0
    DISCARD=0
    MIGRATION=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --version)
                use_version "${2:-}"
                VERSION_GIVEN=1
                shift 2
                ;;
            --version=*)
                use_version "${1#*=}"
                VERSION_GIVEN=1
                shift
                ;;
            --check) CHECK_ONLY=1; shift ;;
            --json) JSON=1; shift ;;
            --yes) YES=1; shift ;;
            --compose-only) COMPOSE_ONLY=1; shift ;;
            --discard-local-changes) DISCARD=1; shift ;;
            --migration)
                MIGRATION="${2:-}"
                if [[ -z "$MIGRATION" || "$MIGRATION" == --* ]]; then
                    echo "[!] --migration benötigt die ID der Migration."
                    exit 2
                fi
                shift 2
                ;;
            --migration=*)
                MIGRATION="${1#*=}"
                if [[ -z "$MIGRATION" ]]; then
                    echo "[!] --migration benötigt die ID der Migration."
                    exit 2
                fi
                shift
                ;;
            *)
                echo "Unbekannter Parameter: $1"
                usage
                exit 2
                ;;
        esac
    done

    if [[ $JSON -eq 1 && $CHECK_ONLY -eq 0 ]]; then
        echo "[!] --json gibt es nur zusammen mit --check."
        usage
        exit 2
    fi

    if [[ -z "${EDULUTION_UPDATE_SKIP_ROOT_CHECK:-}" && $EUID -ne 0 ]]; then
        echo "[!] Bitte als root ausführen, z.B. mit sudo."
        exit 1
    fi

    if [[ ! -f "${DIRECTORY}edulution.env" ]]; then
        echo "[!] ${DIRECTORY}edulution.env nicht gefunden. Ist edulution hier installiert?"
        exit 1
    fi

    # The container's lock covers only its own run; this one keeps a second script from
    # changing the restart marker between this one reading it and finishing its steps.
    if [[ $CHECK_ONLY -eq 0 ]]; then
        exec 9> "${DIRECTORY}.update-script.lock"
        if ! flock -n 9; then
            echo "[!] Ein anderes Update läuft bereits."
            exit 3
        fi
    fi

    # The pending restart belongs to the release that wrote the files: checked against a newer one,
    # the run would apply that template instead of only restarting. --compose-only restarts nothing
    # and writes the files of its own release.
    if [[ -s "$RESTART_PENDING" && $COMPOSE_ONLY -eq 0 ]]; then
        # A --check holds no lock, so a running update may remove the marker in between.
        recorded=$(head -n 1 "$RESTART_PENDING" 2>/dev/null) || recorded=""
        recorded=${recorded//[[:space:]]/}
        if [[ "$recorded" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ && "$recorded" != "$EDULUTION_INSTALLER_VERSION" ]]; then
            if [[ $VERSION_GIVEN -eq 0 ]]; then
                echo "Der Neustart der Dienste nach dem Update auf ${recorded} steht noch aus."
                use_version "$recorded"
            elif [[ $CHECK_ONLY -eq 0 ]]; then
                echo "[!] Der Neustart der Dienste nach dem Update auf ${recorded} steht noch aus. Zuerst diesen abschließen:"
                echo "    curl -fsSL https://get.edulution.io/update | sudo bash -s -- --version ${recorded}"
                exit 2
            fi
        fi
    fi

    echo "edulution update (Installer ${EDULUTION_INSTALLER_VERSION})"

    if ! docker pull "$EDULUTION_INSTALLER_IMAGE"; then
        if docker image inspect "$EDULUTION_INSTALLER_IMAGE" >/dev/null 2>&1; then
            echo "[!] ${EDULUTION_INSTALLER_IMAGE} konnte nicht geladen werden, das lokale Image wird verwendet."
        else
            echo "[!] Das Image ${EDULUTION_INSTALLER_IMAGE} konnte nicht geladen werden."
            exit 1
        fi
    fi

    if [[ $CHECK_ONLY -eq 1 ]]; then
        check_args=(check)
        [[ $JSON -eq 0 ]] || check_args+=(--json)
        [[ ! -e "$RESTART_PENDING" ]] || check_args+=(--restart-pending)
        resolve_config
        rc=0
        run_update "${check_args[@]}" >&4 || rc=$?
        [[ $rc -ne 5 ]] || downgrade_hint
        old_image_hint "$rc"
        exit "$rc"
    fi

    # Taken before check: if the files change after it, apply refuses with exit 4 instead of
    # applying changes the operator was not shown.
    rc=0
    token=$(run_update expect) || rc=$?
    if [[ $rc -ne 0 ]]; then
        old_image_hint "$rc"
        exit "$rc"
    fi

    resolve_config
    rc=0
    run_update check >&4 || rc=$?
    case $rc in
        0)
            if [[ -z "$MIGRATION" ]]; then
                if [[ ! -e "$RESTART_PENDING" ]]; then
                    echo "Die Installation ist aktuell, es gibt nichts zu tun."
                elif [[ $COMPOSE_ONLY -eq 1 ]]; then
                    echo "Die Dateien sind aktuell; der Neustart der Dienste steht noch aus:"
                    restart_hint
                else
                    check_before_restart
                    echo "Die Dateien sind aktuell; der Neustart der Dienste nach dem letzten Update wird nachgeholt."
                    restart_services
                    echo "Update abgeschlossen."
                    if newer "$OWN_VERSION" "$EDULUTION_INSTALLER_VERSION"; then
                        echo "Version ${OWN_VERSION} ist verfügbar; ein weiterer Aufruf des Updates wendet sie an."
                    fi
                fi
                exit 0
            fi
            ;;
        5)
            downgrade_hint
            exit 5
            ;;
        10) ;;
        20) ;;
        30)
            if [[ -z "$MIGRATION" ]]; then
                echo "Vor diesem Update ist eine größere Migration nötig. Die IDs stehen oben unter"
                echo "\"Verfügbare größere Migrationen\"; ausführen mit:"
                echo "  curl -fsSL https://get.edulution.io/update | sudo bash -s -- --migration <ID>"
                exit 30
            fi
            ;;
        *) exit "$rc" ;;
    esac

    echo "Vor jeder Änderung werden die bisherigen Dateien gesichert in ${DIRECTORY}docker-compose-backups/"
    if [[ $rc -eq 20 ]]; then
        echo "Lokale Änderungen in docker-compose.yml bleiben danach nur im Backup erhalten."
        echo "Eigene Anpassungen gehören in docker-compose.override.yml."
    fi

    if [[ $YES -eq 1 ]]; then
        if [[ $rc -eq 20 && $DISCARD -eq 0 ]]; then
            echo "[!] Mit --discard-local-changes werden die lokalen Änderungen verworfen (Backup bleibt). Eigene Anpassungen gehören in docker-compose.override.yml."
            exit 20
        fi
    else
        if ! { : < "$TTY_FILE"; } 2>/dev/null; then
            echo "[!] Kein Terminal für die Rückfrage verfügbar. Mit --yes ohne Rückfrage ausführen."
            exit 2
        fi
        exec 3< "$TTY_FILE"
        read -r -p "Update jetzt anwenden? [j/N] " answer <&3 || answer=""
        if [[ ! "$answer" =~ ^[jJyY]$ ]]; then
            echo "Abgebrochen, es wurde nichts geändert."
            exit 2
        fi
        if [[ $rc -eq 20 && $DISCARD -eq 0 ]]; then
            read -r -p "Lokale Änderungen in docker-compose.yml verwerfen? Sie stehen danach nur noch im Backup. [j/N] " answer <&3 || answer=""
            if [[ ! "$answer" =~ ^[jJyY]$ ]]; then
                echo "Abgebrochen, es wurde nichts geändert."
                exit 2
            fi
            DISCARD=1
        fi
    fi

    args=(--yes "--expect=${token}")
    [[ $DISCARD -eq 1 ]] && args+=(--discard-local-changes)

    # Set before the container writes anything, so an interruption after the writes keeps the restart pending.
    had_pending=0
    previous=""
    if [[ -e "$RESTART_PENDING" ]]; then
        had_pending=1
        previous=$(cat "$RESTART_PENDING")
    fi
    printf '%s\n' "$EDULUTION_INSTALLER_VERSION" > "$RESTART_PENDING"

    rc=0
    if [[ -n "$MIGRATION" ]]; then
        run_update migrate --id "$MIGRATION" "${args[@]}" >&4 || rc=$?
    else
        run_update apply "${args[@]}" >&4 || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        if nothing_written "$rc" "$token"; then
            # The files on disk are still those of the earlier marker, if any.
            if [[ $had_pending -eq 0 ]]; then
                rm -f "$RESTART_PENDING"
            else
                { [[ -z "$previous" ]] || printf '%s\n' "$previous"; } > "$RESTART_PENDING"
            fi
        fi
        exit "$rc"
    fi

    if [[ $COMPOSE_ONLY -eq 1 ]]; then
        echo "Dateien aktualisiert. Die Dienste wurden nicht neu gestartet (--compose-only). Neustart mit:"
        restart_hint
        exit 0
    fi

    # Also after an update that only set the version header: what the restart starts is checked here.
    check_before_restart
    restart_services
    if [[ -n "$MIGRATION" ]]; then
        echo "Migration ${MIGRATION} abgeschlossen."
    else
        echo "Update abgeschlossen."
    fi
}

main "$@"
