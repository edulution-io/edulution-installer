#!/bin/bash

###########################################################
# Update for an edulution UI installation
# by Netzint GmbH
###########################################################

set -euo pipefail

DIRECTORY="/srv/docker/edulution-ui/"
# Image und Version dieses Skripts. Ein Release ersetzt beide Zeilen durch den veroeffentlichten Digest und seine Version.
EDULUTION_INSTALLER_IMAGE="ghcr.io/edulution-io/edulution-installer:latest"
EDULUTION_INSTALLER_VERSION="dev"
# Test hooks: directory, terminal and root check.
DIRECTORY="${EDULUTION_UPDATE_DIR:-$DIRECTORY}"
DIRECTORY="${DIRECTORY%/}/"
TTY_FILE="${EDULUTION_UPDATE_TTY:-/dev/tty}"
# Set once apply has written the files and removed after the services restarted, so a later run finishes the restart.
RESTART_PENDING="${DIRECTORY}.update-restart-pending"

use_version() {
    local version="${1#v}"
    if [[ -z "$version" || "$version" == --* ]]; then
        echo "[!] --version benötigt eine Version, z.B. --version 2.1.0-rc.1"
        exit 2
    fi
    EDULUTION_INSTALLER_IMAGE="ghcr.io/edulution-io/edulution-installer:${version}"
    EDULUTION_INSTALLER_VERSION="${version}"
    echo "Version ${version} wird verwendet (Image ${EDULUTION_INSTALLER_IMAGE})."
}

downgrade_hint() {
    echo "[!] Die Installation ist neuer als dieses Update-Skript (Installer ${EDULUTION_INSTALLER_VERSION}), ein Downgrade wird abgelehnt."
    echo "    Mit --version <X.Y.Z> die Version der Installation oder eine neuere wählen."
}

usage() {
    echo "Verwendung: update [--version <X.Y.Z[-rc.N]>] [--check [--json]] [--yes] [--compose-only]"
    echo "              [--discard-local-changes] [--migration <ID>]"
}

run_update() {
    local mounts=(-v "${DIRECTORY}:/edulution-ui")
    # Backups are named after the local time; without the file the container runs on UTC.
    if [[ -e /etc/localtime ]]; then
        mounts+=(-v /etc/localtime:/etc/localtime:ro)
    fi
    docker run --rm "${mounts[@]}" "$EDULUTION_INSTALLER_IMAGE" python -m update "$@"
}

restart_hint() {
    echo "    docker compose --project-directory ${DIRECTORY} pull && docker compose --project-directory ${DIRECTORY} up -d"
}

restart_services() {
    if ! docker compose --project-directory "$DIRECTORY" pull || ! docker compose --project-directory "$DIRECTORY" up -d; then
        echo "[!] Die Dateien wurden aktualisiert, aber das Neustarten der Dienste ist fehlgeschlagen."
        echo "    Ein erneuter Aufruf des Updates versucht es noch einmal, oder von Hand:"
        restart_hint
        echo "    Sicherungen der alten Dateien: ${DIRECTORY}docker-compose-backups/"
        exit 1
    fi
    rm -f "$RESTART_PENDING"
}

main() {
    # The script's own messages go to stderr and fd 4 keeps stdout for the container's output,
    # so --check --json prints nothing but the JSON on stdout.
    exec 4>&1 1>&2

    CHECK_ONLY=0
    JSON=0
    YES=0
    COMPOSE_ONLY=0
    DISCARD=0
    MIGRATION=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --version)
                use_version "${2:-}"
                shift 2
                ;;
            --version=*)
                use_version "${1#*=}"
                shift
                ;;
            --check) CHECK_ONLY=1; shift ;;
            --json) JSON=1; shift ;;
            --yes) YES=1; shift ;;
            --compose-only) COMPOSE_ONLY=1; shift ;;
            --discard-local-changes) DISCARD=1; shift ;;
            --migration)
                MIGRATION="${2:-}"
                if [[ -z "$MIGRATION" || "$MIGRATION" == --* ]]; then
                    echo "[!] --migration benötigt die ID der Migration."
                    exit 2
                fi
                shift 2
                ;;
            --migration=*)
                MIGRATION="${1#*=}"
                if [[ -z "$MIGRATION" ]]; then
                    echo "[!] --migration benötigt die ID der Migration."
                    exit 2
                fi
                shift
                ;;
            *)
                echo "Unbekannter Parameter: $1"
                usage
                exit 2
                ;;
        esac
    done

    if [[ $JSON -eq 1 && $CHECK_ONLY -eq 0 ]]; then
        echo "[!] --json gibt es nur zusammen mit --check."
        usage
        exit 2
    fi

    if [[ -z "${EDULUTION_UPDATE_SKIP_ROOT_CHECK:-}" && $EUID -ne 0 ]]; then
        echo "[!] Bitte als root ausführen, z.B. mit sudo."
        exit 1
    fi

    if [[ ! -f "${DIRECTORY}edulution.env" ]]; then
        echo "[!] ${DIRECTORY}edulution.env nicht gefunden. Ist edulution hier installiert?"
        exit 1
    fi

    echo "edulution update (Installer ${EDULUTION_INSTALLER_VERSION})"

    if ! docker pull "$EDULUTION_INSTALLER_IMAGE"; then
        if docker image inspect "$EDULUTION_INSTALLER_IMAGE" >/dev/null 2>&1; then
            echo "[!] ${EDULUTION_INSTALLER_IMAGE} konnte nicht geladen werden, das lokale Image wird verwendet."
        else
            echo "[!] Das Image ${EDULUTION_INSTALLER_IMAGE} konnte nicht geladen werden."
            exit 1
        fi
    fi

    if [[ $CHECK_ONLY -eq 1 ]]; then
        check_args=(check)
        [[ $JSON -eq 0 ]] || check_args+=(--json)
        [[ ! -e "$RESTART_PENDING" ]] || check_args+=(--restart-pending)
        rc=0
        run_update "${check_args[@]}" >&4 || rc=$?
        [[ $rc -ne 5 ]] || downgrade_hint
        exit "$rc"
    fi

    # Taken before check: if the files change after it, apply refuses with exit 4 instead of
    # applying changes the operator was not shown.
    token=$(run_update expect)

    rc=0
    run_update check >&4 || rc=$?
    case $rc in
        0)
            if [[ -z "$MIGRATION" ]]; then
                if [[ ! -e "$RESTART_PENDING" ]]; then
                    echo "Die Installation ist aktuell, es gibt nichts zu tun."
                elif [[ $COMPOSE_ONLY -eq 1 ]]; then
                    echo "Die Dateien sind aktuell; der Neustart der Dienste steht noch aus:"
                    restart_hint
                else
                    echo "Die Dateien sind aktuell; der Neustart der Dienste nach dem letzten Update wird nachgeholt."
                    restart_services
                    echo "Update abgeschlossen."
                fi
                exit 0
            fi
            ;;
        5)
            downgrade_hint
            exit 5
            ;;
        10) ;;
        20) ;;
        30)
            if [[ -z "$MIGRATION" ]]; then
                echo "Vor diesem Update ist eine größere Migration nötig. Die IDs stehen oben unter"
                echo "\"Verfügbare größere Migrationen\"; ausführen mit:"
                echo "  curl -fsSL https://get.edulution.io/update | sudo bash -s -- --migration <ID>"
                exit 30
            fi
            ;;
        *) exit "$rc" ;;
    esac

    echo "Vor jeder Änderung werden die bisherigen Dateien gesichert in ${DIRECTORY}docker-compose-backups/"
    if [[ $rc -eq 20 ]]; then
        echo "Lokale Änderungen in docker-compose.yml bleiben danach nur im Backup erhalten."
        echo "Eigene Anpassungen gehören in docker-compose.override.yml."
    fi

    if [[ $YES -eq 1 ]]; then
        if [[ $rc -eq 20 && $DISCARD -eq 0 ]]; then
            echo "[!] Mit --discard-local-changes werden die lokalen Änderungen verworfen (Backup bleibt). Eigene Anpassungen gehören in docker-compose.override.yml."
            exit 20
        fi
    else
        if ! { : < "$TTY_FILE"; } 2>/dev/null; then
            echo "[!] Kein Terminal für die Rückfrage verfügbar. Mit --yes ohne Rückfrage ausführen."
            exit 2
        fi
        exec 3< "$TTY_FILE"
        read -r -p "Update jetzt anwenden? [j/N] " answer <&3 || answer=""
        if [[ ! "$answer" =~ ^[jJyY]$ ]]; then
            echo "Abgebrochen, es wurde nichts geändert."
            exit 2
        fi
        if [[ $rc -eq 20 && $DISCARD -eq 0 ]]; then
            read -r -p "Lokale Änderungen in docker-compose.yml verwerfen? Sie stehen danach nur noch im Backup. [j/N] " answer <&3 || answer=""
            if [[ ! "$answer" =~ ^[jJyY]$ ]]; then
                echo "Abgebrochen, es wurde nichts geändert."
                exit 2
            fi
            DISCARD=1
        fi
    fi

    args=(--yes "--expect=${token}")
    [[ $DISCARD -eq 1 ]] && args+=(--discard-local-changes)

    # Set before the container writes anything, so an interruption after the writes keeps the restart pending.
    had_pending=0
    [[ ! -e "$RESTART_PENDING" ]] || had_pending=1
    touch "$RESTART_PENDING"

    rc=0
    if [[ -n "$MIGRATION" ]]; then
        run_update migrate --id "$MIGRATION" "${args[@]}" >&4 || rc=$?
    else
        run_update apply "${args[@]}" >&4 || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        # These codes come from checks that run before any file is written.
        case $rc in
            2 | 3 | 4 | 5 | 20 | 30) [[ $had_pending -eq 1 ]] || rm -f "$RESTART_PENDING" ;;
        esac
        exit "$rc"
    fi

    if [[ $COMPOSE_ONLY -eq 1 ]]; then
        echo "Dateien aktualisiert. Die Dienste wurden nicht neu gestartet (--compose-only). Neustart mit:"
        restart_hint
        exit 0
    fi

    restart_services
    if [[ -n "$MIGRATION" ]]; then
        echo "Migration ${MIGRATION} abgeschlossen."
    else
        echo "Update abgeschlossen."
    fi
}

main "$@"
