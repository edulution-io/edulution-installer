#!/usr/bin/env bash
set -Ee -o pipefail

###########################################################
# Installer for edulution UI
# V2.0
# by Netzint GmbH
###########################################################

DIRECTORY="/srv/docker/edulution-ui/"
# Tag des zu ladenden Docker-Images (Docker-Tags duerfen kein "/" enthalten).
EDULUTION_INSTALLER_TAG="main"
# Git-Branch, aus dem der Installer arbeitet (z.B. LMN-Bootstrap). Darf "/" enthalten.
EDULUTION_INSTALLER_BRANCH="main"
EDULUTION_INSTALLER_IMAGE="ghcr.io/edulution-io/edulution-installer"
SOURCE_REPOSITORY="edulution-io/edulution-installer"
DOWNLOAD_BASE_URL="https://get.edulution.io/download"
DOWNLOAD_BASE_URL_EXPLICIT=false

info() {
    printf '[*] %s\n' "$*"
}

fatal() {
    printf '[!] %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Verwendung: installer [Optionen]

Optionen:
  --branch <name>              Installer-Image und Vorlagen aus diesem Git-Branch verwenden
  --image <repository>         Docker-Image-Repository verwenden (ohne Tag)
  --source-repository <name>   GitHub-Repository fuer Branch-Vorlagen (OWNER/REPO)
  --download-base-url <url>    URL, unter der die Konfigurationsvorlagen liegen
  --dev | --ssl                Kompatibilitaetsoptionen fuer die bisherigen Test-Tags
  -h | --help                  Diese Hilfe anzeigen

Beispiel fuer einen Branch-Test:
  curl -fsSL https://raw.githubusercontent.com/OWNER/REPO/BRANCH/apps/public-page/public/installer \
    | sudo bash -s -- --branch BRANCH --image ghcr.io/OWNER/REPO --source-repository OWNER/REPO
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dev)
            echo "Entwicklermodus aktiviert! Es werden Test-Pakete verwendet!"
            read -p "Möchtest du wirklich fortfahren? [j/N] " confirm
            if [[ ! "$confirm" =~ ^[Jj]$ ]]; then
                echo "Abgebrochen!"
                exit 1
            fi
            EDULUTION_INSTALLER_TAG="dev"
            EDULUTION_INSTALLER_BRANCH="dev"
            shift
            ;;
        --ssl)
            echo "SSL-Testmodus aktiviert! Es werden Test-Pakete verwendet!"
            read -p "Möchtest du wirklich fortfahren? [j/N] " confirm
            if [[ ! "$confirm" =~ ^[Jj]$ ]]; then
                echo "Abgebrochen!"
                exit 1
            fi
            EDULUTION_INSTALLER_TAG="ssl"
            EDULUTION_INSTALLER_BRANCH="ssl"
            shift
            ;;
        --branch)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "[!] --branch benötigt einen Branch-Namen, z.B. --branch feat/lmn-same-machine"
                exit 1
            fi
            EDULUTION_INSTALLER_BRANCH="$2"
            # Docker-Image-Tag: "/" ist in Tags nicht erlaubt -> durch "-" ersetzen
            # (entspricht dem Tag, das docker/metadata-action im CI erzeugt).
            EDULUTION_INSTALLER_TAG="${2//\//-}"
            if [ "$DOWNLOAD_BASE_URL_EXPLICIT" = false ]; then
                DOWNLOAD_BASE_URL="https://raw.githubusercontent.com/${SOURCE_REPOSITORY}/${EDULUTION_INSTALLER_BRANCH}/apps/public-page/public/download"
            fi
            echo "Branch-Modus aktiviert! Es wird das Image des Branches '${EDULUTION_INSTALLER_BRANCH}' (Tag '${EDULUTION_INSTALLER_TAG}') verwendet!"
            shift 2
            ;;
        --branch=*)
            EDULUTION_INSTALLER_BRANCH="${1#*=}"
            EDULUTION_INSTALLER_TAG="${EDULUTION_INSTALLER_BRANCH//\//-}"
            if [ "$DOWNLOAD_BASE_URL_EXPLICIT" = false ]; then
                DOWNLOAD_BASE_URL="https://raw.githubusercontent.com/${SOURCE_REPOSITORY}/${EDULUTION_INSTALLER_BRANCH}/apps/public-page/public/download"
            fi
            echo "Branch-Modus aktiviert! Es wird das Image des Branches '${EDULUTION_INSTALLER_BRANCH}' (Tag '${EDULUTION_INSTALLER_TAG}') verwendet!"
            shift
            ;;
        --image)
            if [[ -z "${2:-}" || "$2" == --* ]]; then
                fatal "--image benötigt ein Image-Repository, z.B. ghcr.io/edulution-io/edulution-installer"
            fi
            EDULUTION_INSTALLER_IMAGE="$2"
            shift 2
            ;;
        --image=*)
            EDULUTION_INSTALLER_IMAGE="${1#*=}"
            shift
            ;;
        --source-repository)
            if [[ -z "${2:-}" || "$2" == --* ]]; then
                fatal "--source-repository benötigt OWNER/REPO"
            fi
            SOURCE_REPOSITORY="$2"
            shift 2
            ;;
        --source-repository=*)
            SOURCE_REPOSITORY="${1#*=}"
            shift
            ;;
        --download-base-url)
            if [[ -z "${2:-}" || "$2" == --* ]]; then
                fatal "--download-base-url benötigt eine URL"
            fi
            DOWNLOAD_BASE_URL="${2%/}"
            DOWNLOAD_BASE_URL_EXPLICIT=true
            shift 2
            ;;
        --download-base-url=*)
            DOWNLOAD_BASE_URL="${1#*=}"
            DOWNLOAD_BASE_URL="${DOWNLOAD_BASE_URL%/}"
            DOWNLOAD_BASE_URL_EXPLICIT=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unbekannter Parameter: $1"
            usage
            exit 1
            ;;
    esac
done

if [ "$DOWNLOAD_BASE_URL_EXPLICIT" = false ] && [ "$EDULUTION_INSTALLER_BRANCH" != "main" ]; then
    DOWNLOAD_BASE_URL="https://raw.githubusercontent.com/${SOURCE_REPOSITORY}/${EDULUTION_INSTALLER_BRANCH}/apps/public-page/public/download"
fi

if [[ -t 1 ]]; then
    clear
fi

cat <<'EOF'
           _       _       _   _
   ___  __| |_   _| |_   _| |_(_) ___  _ __
  / _ \/ _` | | | | | | | | __| |/ _ \| '_ \
 |  __/ (_| | |_| | | |_| | |_| | (_) | | | |
  \___|\__,_|\__,_|_|\__,_|\__|_|\___/|_| |_|

                edulution - Installer

EOF

if [ "$EUID" -ne 0 ]; then
  fatal "Bitte führen Sie das Skript mit Root-Rechten aus, z.B. mit 'sudo bash'."
fi

cpu_flags=$(grep -m1 'flags' /proc/cpuinfo | cut -d: -f2)
if ! (echo "$cpu_flags" | grep -qwE 'cx16' && \
      echo "$cpu_flags" | grep -qwE 'lahf_lm' && \
      echo "$cpu_flags" | grep -qwE 'popcnt' && \
      echo "$cpu_flags" | grep -qwE 'sse4_1' && \
      echo "$cpu_flags" | grep -qwE 'sse4_2' && \
      echo "$cpu_flags" | grep -qwE 'ssse3'); then
    fatal "Die CPU unterstützt kein x86-64-v2. Bitte überprüfe die CPU-Einstellungen deiner VM!"
fi

if [ -f "${DIRECTORY}edulution.env" ]; then
  fatal "Die edulution UI scheint bereits installiert zu sein. Bitte prüfe das Verzeichnis '$DIRECTORY'!"
fi

if [[ ! "$DOWNLOAD_BASE_URL" =~ ^https:// ]]; then
    fatal "Die Download-URL muss mit https:// beginnen."
fi

if [[ -z "$EDULUTION_INSTALLER_IMAGE" || "$EDULUTION_INSTALLER_IMAGE" == *[[:space:]]* ]]; then
    fatal "Ungültiges Installer-Image: '$EDULUTION_INSTALLER_IMAGE'"
fi

if [[ ! "$SOURCE_REPOSITORY" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    fatal "Ungültiges GitHub-Repository: '$SOURCE_REPOSITORY'"
fi

if [ ! -f /etc/os-release ]; then
    fatal "Betriebssystem konnte nicht ermittelt werden."
fi

. /etc/os-release
if [ "$ID" != "ubuntu" ] || { [ "$VERSION_ID" != "22.04" ] && [ "$VERSION_ID" != "24.04" ]; }; then
    fatal "Dieses Skript unterstützt nur Ubuntu 22.04 und 24.04."
fi

apt-get update
apt-get install -y ca-certificates curl gnupg jq lsb-release

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    info "Docker oder Docker Compose ist nicht vollständig installiert. Installation wird gestartet..."
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg

    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
        > /etc/apt/sources.list.d/docker.list
    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    systemctl enable --now docker
else
    info "Docker und Docker Compose sind bereits installiert."
fi

docker info >/dev/null

info "Erstelle Ordner für die edulution-Installation..."
mkdir -p "$DIRECTORY"
cd "$DIRECTORY"

download_template() {
    local file="$1"
    local target="${DIRECTORY}${file}"
    local temporary_target="${target}.tmp"

    info "Lade Datei ${file} herunter..."
    rm -f "$temporary_target"
    if ! curl --fail --show-error --silent --location --retry 3 \
        --output "$temporary_target" "${DOWNLOAD_BASE_URL}/${file}.template"; then
        rm -f "$temporary_target"
        fatal "Datei '${file}' konnte nicht von ${DOWNLOAD_BASE_URL} heruntergeladen werden."
    fi
    if [ ! -s "$temporary_target" ]; then
        rm -f "$temporary_target"
        fatal "Die heruntergeladene Datei '${file}' ist leer."
    fi
    mv "$temporary_target" "$target"
}

for file in docker-compose.yml realm-edulution.json traefik.yml edulution-default.yml edulution-default-le.yml; do
    download_template "$file"
done

info "Passe die Proxy-Konfiguration an..."

mkdir -p "${DIRECTORY}data/traefik/config"
mkdir -p "${DIRECTORY}data/traefik/ssl"
mkdir -p "${DIRECTORY}data/public/downloads"
mkdir -p "${DIRECTORY}data/apps"
mkdir -p "${DIRECTORY}data/apps/desktopdeployment/edulution-guacamole/config"

chmod -R u+rwX,go+rX "${DIRECTORY}data"

mv "${DIRECTORY}edulution-default.yml" "${DIRECTORY}data/traefik/config"

if docker container inspect edulution-installer >/dev/null 2>&1; then
    fatal "Der Container 'edulution-installer' existiert bereits. Bitte zuerst prüfen oder entfernen."
fi

info "Starte den edulution-Web-Installer (${EDULUTION_INSTALLER_IMAGE}:${EDULUTION_INSTALLER_TAG})..."

docker pull "${EDULUTION_INSTALLER_IMAGE}:${EDULUTION_INSTALLER_TAG}"

docker run -d --name edulution-installer -p 443:8000 \
    -v "${DIRECTORY}:/edulution-ui/" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -e "EDULUTION_DIRECTORY=/edulution-ui" \
    -e "BOOTSTRAP_BRANCH=${EDULUTION_INSTALLER_BRANCH}" \
    "${EDULUTION_INSTALLER_IMAGE}:${EDULUTION_INSTALLER_TAG}"

# Warte bis der Installer bereit ist
attempt=0
until curl --output /dev/null --silent --insecure --get --fail "https://localhost:443" 2>/dev/null; do
    attempt=$((attempt+1))

    if [ $attempt -ge 60 ]; then
        echo "[!] Der Web-Installer konnte nicht gestartet werden!"
        docker logs edulution-installer
        exit 1
    fi

    echo "[*] Warten bis der Web-Installer gestartet ist (Versuch ${attempt} / 60)"
    sleep 3
done

cat <<EOF

########################################################

    edulution Web-Installer

    Sie erreichen die Oberfläche wie folgt:
EOF

echo "    https://$(hostname):443"
echo "    https://$(hostname -I | awk '{print $1}'):443"

cat <<EOF

########################################################

EOF

# Warte bis die Konfiguration vom Web-Installer erstellt wurde
info "Warte auf Abschluss der Web-Installation..."
attempt=0
while [ ! -f "${DIRECTORY}edulution.env" ]; do
    attempt=$((attempt+1))

    # Prüfe ob Container noch läuft
    if [ "$(docker container inspect -f '{{.State.Running}}' edulution-installer 2>/dev/null || true)" != "true" ]; then
        echo "[!] Der Web-Installer wurde unerwartet beendet!"
        docker logs edulution-installer
        exit 1
    fi

    if [ $attempt -ge 1200 ]; then
        echo "[!] Timeout: Die Installation wurde nicht innerhalb von 60 Minuten abgeschlossen!"
        exit 1
    fi

    sleep 3
done

info "Web-Installation abgeschlossen! Fahre mit der Konfiguration fort..."
docker rm -f edulution-installer

info "Starte den Authentifizierungsserver, um die Einstellungen festzulegen..."

docker network create edulution-prepare

docker pull postgres:16
docker pull quay.io/keycloak/keycloak:26.4

docker run -d \
  --name edulution-keycloak-db \
  --restart always \
  --env-file "${DIRECTORY}edulution.env" \
  -e POSTGRES_DB=keycloak \
  -v "${DIRECTORY}data/keycloak/db:/var/lib/postgresql/data" \
  --network edulution-prepare \
  postgres:16

docker run -d \
  --name edulution-keycloak \
  --restart always \
  --env-file "${DIRECTORY}edulution.env" \
  -v "${DIRECTORY}realm-edulution.json:/opt/keycloak/data/import/realm-edulution.json" \
  -e KC_DB_URL=jdbc:postgresql://edulution-keycloak-db/keycloak \
  -e KC_DB=postgres \
  -e KC_DB_URL_DATABASE=keycloak \
  -e KC_DB_SCHEMA=public \
  -e KC_PROXY=edge \
  -e KC_HOSTNAME_STRICT=false \
  -e KC_HOSTNAME_STRICT_HTTPS=false \
  -e KC_HTTP_RELATIVE_PATH=/auth \
  -p 8080:8080 \
  --network edulution-prepare \
  quay.io/keycloak/keycloak:26.4 \
  start-dev \
  --import-realm

attempt=0
until curl --output /dev/null --silent --get --fail "http://localhost:8080/auth/realms/master"; do
    attempt=$((attempt+1))
  
    if [ $attempt -ge 60 ]; then
        echo "[!] Es konnte kein Verbindung zum Authentifizierungserver hergestellt werden!"
        exit 1
    fi

    echo "[*] Warten bis der Authentifizierungserver gestartet ist (Versuch ${attempt} / 60)"
    sleep 3
done

source "${DIRECTORY}edulution.env"

if ! AUTH_TOKEN=$(curl --fail --show-error --silent --request POST 'http://localhost:8080/auth/realms/master/protocol/openid-connect/token' \
                --header 'Content-Type: application/x-www-form-urlencoded' \
                --data-urlencode "username=${KEYCLOAK_ADMIN}" \
                --data-urlencode "password=${KEYCLOAK_ADMIN_PASSWORD}" \
                --data-urlencode 'grant_type=password' \
                --data-urlencode 'client_id=admin-cli' | jq -er '.access_token'); then
    fatal "Es konnte kein Token vom Authentifizierungsserver abgerufen werden."
fi

if [ -z "${AUTH_TOKEN}" ]; then
    fatal "Es konnte kein Token vom Authentifizierungsserver abgerufen werden."
fi

if ! KEYCLOAK_KEYS=$(curl --fail --show-error --silent --request GET 'http://localhost:8080/auth/admin/realms/edulution/keys' \
                        --header "Authorization: Bearer ${AUTH_TOKEN}" \
                        --header 'Content-Type: application/json'); then
    fatal "Die Authentifizierungsschlüssel konnten nicht abgerufen werden."
fi

if ! KEYCLOAK_PUBLIC_KEY=$(jq -er '[.keys[] | select(.algorithm == "RS256") | .publicKey][0]' <<<"${KEYCLOAK_KEYS}"); then
    fatal "Der öffentliche RS256-Schlüssel konnte nicht abgerufen werden."
fi
if ! KEYCLOAK_CERTIFICATE_KEY=$(jq -er '[.keys[] | select(.algorithm == "RS256") | .certificate][0]' <<<"${KEYCLOAK_KEYS}"); then
    fatal "Das RS256-Zertifikat konnte nicht abgerufen werden."
fi

if [[ -z "${KEYCLOAK_PUBLIC_KEY}" || -z "${KEYCLOAK_CERTIFICATE_KEY}" ]]; then
    fatal "Die Authentifizierungsschlüssel sind unvollständig."
fi

cat <<EOF > "${DIRECTORY}data/edulution.pem"
-----BEGIN CERTIFICATE-----
${KEYCLOAK_CERTIFICATE_KEY}
-----END CERTIFICATE-----

-----BEGIN PUBLIC KEY-----
${KEYCLOAK_PUBLIC_KEY}
-----END PUBLIC KEY-----
EOF

docker stop edulution-keycloak edulution-keycloak-db
docker rm edulution-keycloak edulution-keycloak-db
docker network rm edulution-prepare

rm "${DIRECTORY}realm-edulution.json"

info "Arbeiten am Authentifizierungsserver abgeschlossen."

info "Lade die edulution-Container herunter..."
docker compose --project-directory "$DIRECTORY" pull

info "Konfiguration abgeschlossen. Starte edulution!"

docker compose --project-directory "$DIRECTORY" up -d

if [ -z "$EDULUTION_BASE_DOMAIN" ]; then
    EDULUTION_BASE_DOMAIN=$(hostname)
fi

cat <<EOF

########################################################

   ____ _ _   _      _                                   _     _ 
  / ___| (_) (_) ___| | ____      ___   _ _ __  ___  ___| |__ | |
 | |  _| | | | |/ __| |/ /\ \ /\ / / | | | '_ \/ __|/ __| '_ \| |
 | |_| | | |_| | (__|   <  \ V  V /| |_| | | | \__ \ (__| | | |_|
  \____|_|\__,_|\___|_|\_\  \_/\_/  \__,_|_| |_|___/\___|_| |_(_)
                                                                 
    Die Installation der edulution UI ist abgeschlossen!

    Sie erreichen die Oberfläche wie folgt:
      
    https://$EDULUTION_BASE_DOMAIN                                                            

########################################################

EOF
