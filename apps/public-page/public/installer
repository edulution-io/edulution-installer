#!/bin/bash

###########################################################
# Installer for edulution UI
# V2.0
# by Netzint GmbH
###########################################################

DIRECTORY="/srv/docker/edulution-ui/"
# Image und Git-Ref dieses Installers. Ein Release ersetzt beide Zeilen durch den veroeffentlichten Digest und Tag.
EDULUTION_INSTALLER_IMAGE="ghcr.io/edulution-io/edulution-installer:latest"
EDULUTION_INSTALLER_REF="main"

use_version() {
    local version="${1#v}"
    if [[ -z "$version" || "$version" == --* ]]; then
        echo "[!] --version benötigt eine Version, z.B. --version 2.1.0-rc.1"
        exit 1
    fi
    EDULUTION_INSTALLER_IMAGE="ghcr.io/edulution-io/edulution-installer:${version}"
    EDULUTION_INSTALLER_REF="v${version}"
    echo "Version ${version} wird verwendet (Image ${EDULUTION_INSTALLER_IMAGE})."
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --version)
            use_version "$2"
            shift 2
            ;;
        --version=*)
            use_version "${1#*=}"
            shift
            ;;
        *)
            echo "Unbekannter Parameter: $1"
            echo "Verwendung: $0 [--version <X.Y.Z[-rc.N]>]"
            exit 1
            ;;
    esac
done

clear

cat <<'EOF'
           _       _       _   _
   ___  __| |_   _| |_   _| |_(_) ___  _ __
  / _ \/ _` | | | | | | | | __| |/ _ \| '_ \
 |  __/ (_| | |_| | | |_| | |_| | (_) | | | |
  \___|\__,_|\__,_|_|\__,_|\__|_|\___/|_| |_|

                edulution - Installer

EOF

if [ "$EUID" -ne 0 ]; then
  echo "[!] Bitte führen Sie das Skript mit Root-Rechten aus."
  exit 1
fi

cpu_flags=$(grep -m1 'flags' /proc/cpuinfo | cut -d: -f2)
if ! (echo "$cpu_flags" | grep -qwE 'cx16' && \
      echo "$cpu_flags" | grep -qwE 'lahf_lm' && \
      echo "$cpu_flags" | grep -qwE 'popcnt' && \
      echo "$cpu_flags" | grep -qwE 'sse4_1' && \
      echo "$cpu_flags" | grep -qwE 'sse4_2' && \
      echo "$cpu_flags" | grep -qwE 'ssse3'); then
    echo "[!] Die CPU unterstützt kein x86-64-v2. Bitte überprüfe die CPU Einstellungen deiner VM!"
    exit 1
fi

# MongoDB ab 5.0 (hier: mongo:7) wird mit AVX kompiliert und stuerzt ohne diese
# CPU-Erweiterung sofort mit "Illegal instruction (core dumped)" ab. AVX gehoert
# zu x86-64-v3 und ist von der Pruefung oben daher NICHT abgedeckt: verbreitete
# Standard-CPU-Typen wie "x86-64-v2-AES" (Default in Proxmox VE 8) bestehen den
# v2-Test, lassen die Installation aber spaeter an edulution-db scheitern.
if ! echo "$cpu_flags" | grep -qwE 'avx'; then
    echo "[!] Die CPU unterstützt kein AVX (x86-64-v3), das von der Datenbank (MongoDB) benötigt wird."
    echo "[!] Bitte stelle den CPU-Typ deiner VM auf 'host' (mindestens 'x86-64-v3') um!"
    exit 1
fi

if [ -f "${DIRECTORY}edulution.env" ]; then
  echo "[!] Die edulution UI scheint bereits installiert zu sein. Bitte prüfe das Verzeichnis '$DIRECTORY'!"
  exit 1
fi

if ! command -v docker &> /dev/null; then
    echo "[*] Docker ist nicht installiert. Installation wird gestartet..."

    if [ -f /etc/os-release ]; then
        . /etc/os-release
        OS=$ID
        VERSION=$VERSION_ID
    else
        echo "[!] Betriebssystem konnte nicht ermittelt werden."
        exit 1
    fi

    if [ "$OS" == "ubuntu" ] && ([[ "$VERSION" == "22.04" ]] || [[ "$VERSION" == "24.04" ]] || [[ "$VERSION" == "26.04" ]]); then

        apt-get update

        apt-get install -y \
            ca-certificates \
            curl \
            gnupg \
            lsb-release

        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
            gpg --dearmor -o /etc/apt/keyrings/docker.gpg
        chmod a+r /etc/apt/keyrings/docker.gpg

        echo \
          "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
          $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

        apt-get update

        apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

        systemctl enable docker --now

        echo "[*] Konfiguriere Docker Daemon..."
        cat <<DOCKEREOF > /etc/docker/daemon.json
{
  "live-restore": true,
  "storage-driver": "overlay2",
  "log-opts": {
    "max-size": "100m",
    "max-file": "3"
  }
}
DOCKEREOF

        systemctl daemon-reload
        systemctl restart docker

        echo "[*] Docker wurde erfolgreich installiert."

    else
        echo "[!] Dieses Skript unterstützt nur Ubuntu 22.04, 24.04 und 26.04."
        exit 1
    fi
else
    echo "[*] Docker ist bereits installiert."
    echo "[*] Konfiguriere Docker Daemon..."
    cat <<DOCKEREOF > /etc/docker/daemon.json
{
  "live-restore": true,
  "storage-driver": "overlay2",
  "log-opts": {
    "max-size": "100m",
    "max-file": "3"
  }
}
DOCKEREOF

    systemctl daemon-reload
    systemctl restart docker
    echo "[*] Docker Daemon konfiguriert."
fi

# SSH-Freigabe fuer den edulution-Installer (nur localhost + Docker-Bridge-Netz).
# Muss bereits vor dem Start des Installer-Containers existieren: bei einer
# "gleiche Maschine"-Installation greift der Container per SSH ueber die
# docker0-IP auf den Host zu (der linuxmuster-Bootstrap laeuft dann lokal auf
# diesem Host). Nach der Web-Installation wird die Freigabe wieder entfernt.
echo "[*] Konfiguriere SSH-Zugriff fuer den edulution-Installer (localhost + Docker-Netz)..."
SSH_INSTALLER_CONF=/etc/ssh/sshd_config.d/edulution_installer.conf

restart_ssh() {
    systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || \
        echo "[!] Der SSH-Dienst konnte nicht neu gestartet werden. Bitte 'systemctl restart ssh' ausfuehren."
}

# Auch bei einem Abbruch des Skripts darf die Freigabe nicht bestehen bleiben.
remove_ssh_installer_access() {
    if [ -f "${SSH_INSTALLER_CONF}" ]; then
        rm -f "${SSH_INSTALLER_CONF}"
        restart_ssh
    fi
}
trap remove_ssh_installer_access EXIT
# Bei SIGHUP (abgebrochene SSH-Sitzung) und SIGTERM laeuft die EXIT-Trap sonst nicht zuverlaessig.
trap 'exit 1' HUP TERM

mkdir -p /etc/ssh/sshd_config.d
cat <<'SSHEOF' > "${SSH_INSTALLER_CONF}"
Match Address 127.0.0.1,172.17.0.0/16
    PermitRootLogin yes
    PasswordAuthentication yes
SSHEOF
chmod 0644 "${SSH_INSTALLER_CONF}"
restart_ssh

if ! command -v jq &> /dev/null; then
    echo "[*] JQ ist nicht installiert. Installation wird gestartet..."
    apt-get update
    apt-get install -y jq
fi

echo "[*] Erstelle Ordner für die edulution installation..."
mkdir -p $DIRECTORY
cd $DIRECTORY

# Laedt eine Vorlage von get.edulution.io herunter.
#
# Die fruehere Fassung pruefte nur mit [ -f ], ob die Datei existiert. Das war
# in beide Richtungen unbrauchbar: curl legt die Datei auch bei HTTP 404 an und
# schreibt die HTML-Fehlerseite hinein, sodass ein 404 unbemerkt durchlief und
# der Installer mit Muell weiterarbeitete. Umgekehrt blieb bei einem echten
# Netzfehler nur die Meldung "konnte nicht heruntergeladen werden" ohne jeden
# Hinweis auf die Ursache. Deshalb hier: -f fuer HTTP-Fehler, Wiederholungen
# gegen sporadische Aussetzer und der curl-Exitcode in der Fehlermeldung.
download_template() {
    local file="$1"
    local url="https://get.edulution.io/download/${file}.template"
    local target="${DIRECTORY}${file}"
    local rc

    curl -fsSL \
        --connect-timeout 15 \
        --max-time 300 \
        --retry 5 \
        --retry-delay 3 \
        --retry-connrefused \
        --retry-all-errors \
        -o "${target}" "${url}"
    rc=$?

    if [ $rc -ne 0 ]; then
        rm -f "${target}"
        echo "[!] Datei '$file' konnte nicht heruntergeladen werden! (curl-Exitcode ${rc})"
        echo "[!] URL: ${url}"

        case $rc in
            6)
                echo "[!] 'get.edulution.io' konnte nicht aufgeloest werden - bitte DNS pruefen."
                ;;
            7)
                echo "[!] Es kam keine Verbindung zustande - bitte Firewall oder Proxy pruefen."
                ;;
            22)
                echo "[!] Der Server antwortete mit einem HTTP-Fehlercode."
                ;;
            28)
                echo "[!] Zeitueberschreitung - die Gegenstelle war nicht erreichbar."
                ;;
            35 | 60)
                echo "[!] TLS-Fehler - bricht eine Firewall die HTTPS-Verbindung auf?"
                ;;
        esac

        echo "[!] Zur genaueren Diagnose bitte ausfuehren:"
        echo "[!]   curl -v -o /dev/null ${url}"
        return 1
    fi

    if [ ! -s "${target}" ]; then
        echo "[!] Datei '$file' wurde leer heruntergeladen! (URL: ${url})"
        rm -f "${target}"
        return 1
    fi

    # Ein Captive Portal oder eine Proxy-Fehlerseite antwortet mit HTTP 200 und
    # liefert HTML aus. Keine der Vorlagen beginnt mit '<'.
    if [ "$(head -c 1 "${target}")" = "<" ]; then
        echo "[!] Datei '$file' enthaelt HTML statt der erwarteten Konfiguration!"
        echo "[!] Vermutlich antwortet ein Proxy oder Portal anstelle von get.edulution.io."
        rm -f "${target}"
        return 1
    fi

    return 0
}

for file in docker-compose.yml realm-edulution.json traefik.yml edulution-default.yml edulution-default-le.yml; do

    echo "[*] Herunterladen der Datei $file..."

    if ! download_template "${file}"; then
        exit 1
    fi

done

echo "[*] Anpassung der Proxy-Konfiguration..."

mkdir -p ${DIRECTORY}data/traefik/config
mkdir -p ${DIRECTORY}data/traefik/ssl
mkdir -p ${DIRECTORY}data/public/downloads
mkdir -p ${DIRECTORY}data/apps
mkdir -p ${DIRECTORY}data/apps/desktopdeployment/edulution-guacamole/config

# Das Guacamole-Plugin bindet das Verzeichnis als Home seines Benutzers (UID 1001) ein; sonst schreibt nur root in data/.
chown 1001:1001 ${DIRECTORY}data/apps/desktopdeployment/edulution-guacamole/config

mv ${DIRECTORY}edulution-default.yml ${DIRECTORY}data/traefik/config

echo "[*] Starte den edulution Web-Installer..."

docker pull "${EDULUTION_INSTALLER_IMAGE}" 2>&1 > /dev/zero

# Nur wer die URL mit diesem Token aus der Konsole kennt, erreicht den Web-Installer.
# Uebergabe per Umgebung, damit der Token nicht in der Prozessliste steht.
INSTALLER_TOKEN=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')

INSTALLER_TOKEN="${INSTALLER_TOKEN}" docker run -d --name edulution-installer -p 443:8000 -v ${DIRECTORY}:/edulution-ui/ \
    -e EDULUTION_DIRECTORY=${DIRECTORY} -e BOOTSTRAP_BRANCH=${EDULUTION_INSTALLER_REF} -e INSTALLER_TOKEN \
    "${EDULUTION_INSTALLER_IMAGE}" 2>&1 > /dev/zero

# Warte bis der Installer bereit ist
attempt=0
# Ohne Token und ohne --fail: jede HTTP-Antwort genuegt, auch 401, und der Token bleibt aus der Prozessliste.
until curl --output /dev/null --silent --insecure --get "https://localhost:443" 2>/dev/null; do
    attempt=$((attempt+1))

    if [ $attempt -ge 60 ]; then
        echo "[!] Der Web-Installer konnte nicht gestartet werden!"
        docker logs edulution-installer
        exit 1
    fi

    echo "[*] Warten bis der Web-Installer gestartet ist (Versuch ${attempt} / 60)"
    sleep 3
done

cat <<EOF

########################################################

    edulution Web-Installer

    Sie erreichen die Oberfläche wie folgt:
EOF

echo "    https://$(hostname):443/?token=${INSTALLER_TOKEN}"
echo "    https://$(hostname -I | awk '{print $1}'):443/?token=${INSTALLER_TOKEN}"

cat <<EOF

########################################################

EOF

# Warte bis die Konfiguration vom Web-Installer erstellt wurde
echo "[*] Warte auf Abschluss der Web-Installation..."
attempt=0
while [ ! -f "${DIRECTORY}edulution.env" ]; do
    attempt=$((attempt+1))

    # Prüfe ob Container noch läuft
    if ! docker ps | grep -q edulution-installer; then
        echo "[!] Der Web-Installer wurde unerwartet beendet!"
        docker logs edulution-installer
        exit 1
    fi

    if [ $attempt -ge 1200 ]; then
        echo "[!] Timeout: Die Installation wurde nicht innerhalb von 60 Minuten abgeschlossen!"
        exit 1
    fi

    sleep 3
done

echo "[*] Web-Installation abgeschlossen! Fahre mit der Konfiguration fort..."
docker rm -f edulution-installer 2>&1 > /dev/zero
remove_ssh_installer_access

echo "[*] Starte den Authentifizierungserver um die Einstellungen festzulegen..."

docker network create edulution-prepare 2>&1 > /dev/zero

# Dependabot erfasst diese Pins nicht; sie werden von Hand angehoben.
BOOTSTRAP_POSTGRES_IMAGE="postgres:16.15@sha256:ca0bd484cb98bf4b24eb1010e73fb3fcbd6714d240fbc1a10eea5b7dbecb641d"
BOOTSTRAP_KEYCLOAK_IMAGE="quay.io/keycloak/keycloak:26.7.3"

docker pull "${BOOTSTRAP_POSTGRES_IMAGE}" 2>&1 > /dev/zero
docker pull "${BOOTSTRAP_KEYCLOAK_IMAGE}" 2>&1 > /dev/zero

docker run -d \
  --name edulution-keycloak-db \
  --restart always \
  --env-file ${DIRECTORY}edulution.env \
  -e POSTGRES_DB=keycloak \
  -v ${DIRECTORY}data/keycloak/db:/var/lib/postgresql/data \
  --network edulution-prepare \
  "${BOOTSTRAP_POSTGRES_IMAGE}" 2>&1 > /dev/zero

docker run -d \
  --name edulution-keycloak \
  --restart always \
  --env-file ${DIRECTORY}edulution.env \
  -v ${DIRECTORY}realm-edulution.json:/opt/keycloak/data/import/realm-edulution.json \
  -e KC_DB_URL=jdbc:postgresql://edulution-keycloak-db/keycloak \
  -e KC_DB=postgres \
  -e KC_DB_URL_DATABASE=keycloak \
  -e KC_DB_SCHEMA=public \
  -e KC_PROXY=edge \
  -e KC_HOSTNAME_STRICT=false \
  -e KC_HOSTNAME_STRICT_HTTPS=false \
  -e KC_HTTP_RELATIVE_PATH=/auth \
  -p 127.0.0.1:8080:8080 \
  --network edulution-prepare \
  "${BOOTSTRAP_KEYCLOAK_IMAGE}" \
  start-dev \
  --import-realm 2>&1 > /dev/zero

attempt=0
until curl --output /dev/null --silent --get --fail "http://localhost:8080/auth/realms/master"; do
    attempt=$((attempt+1))
  
    if [ $attempt -ge 60 ]; then
        echo "[!] Es konnte kein Verbindung zum Authentifizierungserver hergestellt werden!"
        exit 1
    fi

    echo "[*] Warten bis der Authentifizierungserver gestartet ist (Versuch ${attempt} / 60)"
    sleep 3
done

source ${DIRECTORY}edulution.env

AUTH_TOKEN=$(curl -s --request POST 'http://localhost:8080/auth/realms/master/protocol/openid-connect/token' \
                --header 'Content-Type: application/x-www-form-urlencoded' \
                --data-urlencode "username=${KEYCLOAK_ADMIN}" \
                --data-urlencode "password=${KEYCLOAK_ADMIN_PASSWORD}" \
                --data-urlencode 'grant_type=password' \
                --data-urlencode 'client_id=admin-cli' | jq '.access_token' | sed 's/\"//g')

if [ -z "${AUTH_TOKEN}" ]; then
    echo "[!] Es konnte kein Verbindung zum Authentifizierungserver hergestellt werden!"
    exit 1
fi

KEYCLOAK_PUBLIC_KEY=$(curl -s --request GET 'http://localhost:8080/auth/admin/realms/edulution/keys' \
                        --header "Authorization: Bearer ${AUTH_TOKEN}" \
                        --header 'Content-Type: application/json' | jq '.keys[] | select(.algorithm == "RS256") | .publicKey' | sed 's/\"//g')

KEYCLOAK_CERTIFICATE_KEY=$(curl -s --request GET 'http://localhost:8080/auth/admin/realms/edulution/keys' \
                        --header "Authorization: Bearer ${AUTH_TOKEN}" \
                        --header 'Content-Type: application/json' | jq '.keys[] | select(.algorithm == "RS256") | .certificate' | sed 's/\"//g')

if [[ -z "${KEYCLOAK_PUBLIC_KEY}" && -z "${KEYCLOAK_CERTIFICATE_KEY}" ]]; then
    echo "[!] Die Authentifizierungsschlüssel konnten nicht abgerufen werden!"
    exit 1
fi

cat <<EOF > ${DIRECTORY}data/edulution.pem
-----BEGIN CERTIFICATE-----
${KEYCLOAK_CERTIFICATE_KEY}
-----END CERTIFICATE-----

-----BEGIN PRIVATE KEY-----
${KEYCLOAK_PUBLIC_KEY}
-----END PRIVATE KEY-----
EOF

docker stop edulution-keycloak 2>&1 > /dev/zero
docker stop edulution-keycloak-db 2>&1 > /dev/zero
docker rm edulution-keycloak 2>&1 > /dev/zero
docker rm edulution-keycloak-db 2>&1 > /dev/zero
docker network rm edulution-prepare 2>&1 > /dev/zero

rm ${DIRECTORY}realm-edulution.json
rm -f ${DIRECTORY}lmn-installer-api.json

echo "[*] Arbeiten am Authentifizierungserver abgeschlossen."

echo "[*] Herunterladen der edulution Container..."
docker compose --project-directory ${DIRECTORY} pull 2>&1 > /dev/zero

echo "[*] Konfiguration abgeschlossen. Starte edulution!"

docker compose --project-directory ${DIRECTORY} up -d 2>&1 > /dev/zero

if [ -z "$EDULUTION_BASE_DOMAIN" ]; then
    EDULUTION_BASE_DOMAIN=$(hostname)
fi

cat <<EOF

########################################################

   ____ _ _   _      _                                   _     _ 
  / ___| (_) (_) ___| | ____      ___   _ _ __  ___  ___| |__ | |
 | |  _| | | | |/ __| |/ /\ \ /\ / / | | | '_ \/ __|/ __| '_ \| |
 | |_| | | |_| | (__|   <  \ V  V /| |_| | | | \__ \ (__| | | |_|
  \____|_|\__,_|\___|_|\_\  \_/\_/  \__,_|_| |_|___/\___|_| |_(_)
                                                                 
    Die Installation der edulution UI ist abgeschlossen!

    Sie erreichen die Oberfläche wie folgt:
      
    https://$EDULUTION_BASE_DOMAIN                                                            

########################################################

EOF