http:
  routers:
    edulution-api:
      rule: "PathPrefix(`/edu-api`)"
      service: edulution-api
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
        domains:
          - main: "*.{{DOMAIN}}"
          - sans: "{{DOMAIN}}"

    edulution-keycloak:
      rule: "PathPrefix(`/auth`)"
      service: edulution-keycloak
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
        domains:
          - main: "*.{{DOMAIN}}"
          - sans: "{{DOMAIN}}"

    # Admin console and admin REST API. Containers use http://edu-keycloak:8080/auth directly instead.
    edulution-keycloak-admin:
      rule: "PathPrefix(`/auth/admin`)"
      service: edulution-keycloak
      middlewares:
        - private-networks-only
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
        domains:
          - main: "*.{{DOMAIN}}"
          - sans: "{{DOMAIN}}"

    edulution-ui:
      rule: "PathPrefix(`/`)"
      service: edulution-ui
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
        domains:
          - main: "*.{{DOMAIN}}"
          - sans: "{{DOMAIN}}"

  middlewares:
    # Not 172.16.0.0/12: Docker uses it, also as the source of IPv6 and local clients.
    private-networks-only:
      ipAllowList:
        sourceRange:
          - "10.0.0.0/8"
          - "192.168.0.0/16"

  services:
    edulution-api:
      loadBalancer:
        servers:
          - url: "http://edu-api:3000"
    edulution-ui:
      loadBalancer:
        servers:
          - url: "http://edu-ui:80"
    edulution-keycloak:
      loadBalancer:
        servers:
          - url: "http://edu-keycloak:8080"
