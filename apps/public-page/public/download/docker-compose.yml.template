services:
  edu-ui:
    container_name: edulution-ui
    image: ghcr.io/edulution-io/edulution-ui
    restart: always
    depends_on:
      edu-api:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "-k", "-I", "http://localhost:80"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 10s

  edu-api:
    container_name: edulution-api
    image: ghcr.io/edulution-io/edulution-api
    restart: always
    env_file:
      - edulution.env
    environment:
      EDUI_PORT: 3000
      EDUI_CORS_URL: '*'
      # optional: error, warn, log, debug, verbose, default log
      #EDUI_LOG_LEVEL:
      # optional: for health check disk space between 0 and 1 (0 and 100%), default: 0.95
      #EDUI_DISK_SPACE_THRESHOLD:
      # optional: Timeout for IMAP fetch in ms, default 5000
      #EDUI_MAIL_IMAP_TIMEOUT:
      # Cache TTL for storing oidc config request in redis in ms, default 1h
      #EDUI_OIDC_CONFIG_CACHE_TTL=
      # optional: fallback address of the fileproxy serving the wiki HTTP API,
      # used when a WebDAV root server carries no address of its own. Must be an
      # origin without a path and must be the fileproxy itself, not the public
      # UI host, e.g. https://fileproxy.example.edu:8443
      #EDUI_FILEPROXY_API_URL=
      KEYCLOAK_API: http://edu-keycloak:8080/auth
      KEYCLOAK_EDU_UI_REALM: edulution
      KEYCLOAK_EDU_UI_CLIENT_ID: edu-ui
      KEYCLOAK_EDU_API_CLIENT_ID: edu-api
      REDIS_HOST: edu-redis
      REDIS_PORT: 6379
      MONGODB_DATABASE_NAME: edulution
    depends_on:
      edu-keycloak:
        condition: service_healthy
      edu-db:
        condition: service_healthy
      edu-redis:
        condition: service_healthy
    volumes:
      - ./data:/opt/edulution/api/data
      - /var/run/docker.sock:/var/run/docker.sock
      - /srv/docker/edulution-mail/mailcow/data/conf/sogo:/data/apps/mail/sogo/overrides:rw
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://localhost:3000/edu-api/health/check', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 10s

  edu-db:
    container_name: edulution-db
    image: mongo:7
    restart: always
    env_file:
      - edulution.env
    # MongoDB runs as a single-node replica set (rs0) because the API writes
    # across collections in multi-document transactions, which are only
    # available on a replica set. Enabling replication together with
    # authorization requires a keyfile for internal auth; it is generated once
    # on first start and kept in ./data/db-keyfile.
    entrypoint:
      - bash
      - -c
      - |
        set -e
        KEYFILE=/keyfile/mongo.key
        if [ ! -s "$$KEYFILE" ]; then
          openssl rand -base64 756 > "$$KEYFILE"
        fi
        chmod 400 "$$KEYFILE"
        chown mongodb:mongodb "$$KEYFILE" 2>/dev/null || true
        exec docker-entrypoint.sh "$$@"
      - bash
    command:
      - mongod
      - --replSet
      - rs0
      - --keyFile
      - /keyfile/mongo.key
      - --bind_ip_all
    volumes:
      - ./data/db:/data/db
      - ./data/db-keyfile:/keyfile
    ulimits:
      nofile:
        soft: 64000
        hard: 64000
    # Initiates the replica set on the first run and reports healthy only once
    # a PRIMARY exists, so that edu-api starts against a transaction capable
    # database. rs.initiate() is idempotent, an existing standalone data
    # directory is promoted in place.
    healthcheck:
      test:
        - CMD-SHELL
        - >
          tr -d '[:space:]' < /keyfile/mongo.key |
          mongosh --quiet -u __system
          --authenticationDatabase local --eval "
          let status; try { status = rs.status(); } catch (e) { rs.initiate({ _id: 'rs0', members: [{ _id: 0, host: 'edulution-db:27017' }] }); status = rs.status(); }
          const primary = status && status.members && status.members.some(m => m.stateStr === 'PRIMARY'); if (!primary) { quit(1); }"
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: 15s

  edu-redis:
    container_name: edulution-redis
    image: redis:8.6
    restart: always
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 5s
      timeout: 1s
      retries: 3
      start_period: 10s
    command: >
      redis-server
        --save ""
        --appendonly no
        --io-threads 2
        --io-threads-do-reads yes

  edu-traefik:
    image: traefik:v3.1
    container_name: edulution-traefik
    restart: always
    ports:
      - 80:80
      - 443:443
    env_file:
      - edulution.env
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/etc/traefik/traefik.yml
      - ./data/traefik/config:/etc/traefik/dynamic
      - ./data/traefik/ssl:/etc/traefik/ssl
      - ./data/letsencrypt:/letsencrypt
    healthcheck:
      test: [ "CMD", "traefik", "healthcheck", "--ping" ]
      interval: 5s
      timeout: 1s
      retries: 3
      start_period: 10s
    
  edu-keycloak:
    image: quay.io/keycloak/keycloak:26.4
    container_name: edulution-keycloak
    restart: always
    command:
      [
        'start',
        '--proxy-headers=xforwarded',
        '--http-enabled=true',
        '--hostname-strict=false'
      ]
    env_file:
      - edulution.env
    environment:
      KC_DB_URL: jdbc:postgresql://edu-keycloak-db/keycloak
      KC_DB: postgres
      KC_DB_URL_DATABASE: keycloak
      KC_DB_SCHEMA: public
      KC_HOSTNAME_STRICT: false
      KC_HTTP_RELATIVE_PATH: /auth
      KC_HEALTH_ENABLED: true
    depends_on:
      edu-keycloak-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "bash", "-c", "echo > /dev/tcp/127.0.0.1/9000"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 20s

  edu-keycloak-db:
    image: postgres:16
    container_name: edulution-keycloak-db
    restart: always
    env_file:
      - edulution.env
    environment:
      POSTGRES_DB: keycloak
    volumes:
      - ./data/keycloak/db:/var/lib/postgresql/data
    healthcheck:
      test: [ "CMD", "pg_isready", "-d", "keycloak", "-U", "keycloak" ]
      interval: 5s
      timeout: 1s
      retries: 3
      start_period: 10s
