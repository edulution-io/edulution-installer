#!/usr/bin/env bash
#
# Throwaway libvirt VMs for testing the installer by hand: an edulution server (edu) and a
# linuxmuster server (lmn) in their own NAT network. See README.md next to this script.

set -euo pipefail

PREFIX=edutest
SUBNET="${VM_TEST_SUBNET:-10.77.0}"
STATE="${VM_TEST_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/edulution-vm-test}"
RUN="$STATE/run"
CACHE="$STATE/cache"
PROTOCOL="$STATE/protocol.md"
POOL="${VM_TEST_POOL:-default}"
V=(virsh -c qemu:///system)

# linuxmuster.net 7.4 needs Ubuntu 26.04.
UBUNTU_RELEASE=26.04
IMAGE_BASE_URL="https://cloud-images.ubuntu.com/releases/${UBUNTU_RELEASE}/release"
IMAGE_FILE="ubuntu-${UBUNTU_RELEASE}-server-cloudimg-amd64.img"
BASE_VOL="${PREFIX}-base.qcow2"

EDU_MEMORY="${VM_TEST_EDU_MEMORY:-6144}"
LMN_MEMORY="${VM_TEST_LMN_MEMORY:-4608}"
# Same version as the CI workflows.
NODE_IMAGE="node:22.23.4-bookworm"
SRC_ON_VM=/root/vm-test-src

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

info() { echo "[vm-test] $*" >&2; }
die() {
    echo "[vm-test] error: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<EOF
Usage: vm-test <command>

  up                         Create the network and both VMs and wait until they answer.
  build [<git-ref>]          Build the installer image from this checkout on the edu VM
                             (default: the working tree, including uncommitted changes to tracked files).
  install [--version X.Y.Z | --local]
                             Start the installer on the edu VM and print the web installer URL.
                             --local uses the image from 'build'; without options the latest release.
  status                     Show the VMs, their addresses and the logins.
  ssh <edu|lmn> [command]    Open a shell on a VM (user edutest, sudo without password).
  down [--keep-image]        Remove everything 'up' created and compare the host with the state before.

State and protocol: $STATE
EOF
}

# Role -> name, address, MAC address.
vm_name() { echo "${PREFIX}-$1"; }
vm_ip() {
    case $1 in
        edu) echo "${SUBNET}.20" ;;
        lmn) echo "${SUBNET}.10" ;;
        *) die "unknown VM '$1', use edu or lmn" ;;
    esac
}
vm_mac() {
    case $1 in
        edu) echo "52:54:00:ed:00:20" ;;
        lmn) echo "52:54:00:ed:00:10" ;;
    esac
}

# Extra ssh options before the host, e.g. -t for an interactive shell.
SSH_EXTRA=()

vm_ssh() {
    local role=$1
    shift
    [[ -f "$RUN/id_ed25519" ]] || die "no environment, run 'vm-test up' first"
    # The VMs live only in the isolated test network and linuxmuster-setup replaces the host keys,
    # so their keys are not kept, neither here nor in ~/.ssh.
    ssh -i "$RUN/id_ed25519" -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no \
        -o LogLevel=ERROR -o ConnectTimeout=5 -o ServerAliveInterval=15 -o BatchMode=yes \
        "${SSH_EXTRA[@]}" "edutest@$(vm_ip "$role")" "$@"
}

# note <change> <undo>: one row in the protocol, written only after the change succeeded.
note() {
    # shellcheck disable=SC2016 # the backticks are Markdown
    printf '| %s | %s | `%s` |\n' "$(date '+%H:%M:%S')" "$1" "$2" >> "$PROTOCOL"
}

note_teardown() {
    printf '| %s | %s |\n' "$(date '+%H:%M:%S')" "$1" >> "$PROTOCOL"
}

# Host state that up changes and down has to restore.
snapshot() {
    "${V[@]}" list --all --name | sed '/^$/d' | sed 's/^/domain: /'
    "${V[@]}" net-list --all --name | sed '/^$/d' | sed 's/^/network: /'
    "${V[@]}" pool-list --all --name | sed '/^$/d' | sed 's/^/pool: /'
    "${V[@]}" vol-list "$POOL" | awk 'NR > 2 && NF { print "volume: " $1 }'
    ip -br link | awk '{ sub(/@.*/, "", $1); print "link: " $1 }' | grep -vE ': (veth|vnet|tap)' || true
    ip -4 route | sed 's/^/route: /'
}

leftovers() {
    "${V[@]}" list --all --name | grep "^${PREFIX}-" || true
    "${V[@]}" net-list --all --name | grep -x "$PREFIX" || true
    "${V[@]}" vol-list "$POOL" | awk 'NR > 2 && NF { print $1 }' | grep "^${PREFIX}-" || true
}

make_seed() {
    local dir=$1 out=$2
    local files=("$dir/user-data" "$dir/meta-data" "$dir/network-config")
    if command -v xorriso > /dev/null; then
        xorriso -as mkisofs -quiet -output "$out" -volid cidata -joliet -rock "${files[@]}" 2> /dev/null
    elif command -v genisoimage > /dev/null; then
        genisoimage -quiet -output "$out" -volid cidata -joliet -rock "${files[@]}"
    elif command -v cloud-localds > /dev/null; then
        cloud-localds -N "$dir/network-config" "$out" "$dir/user-data" "$dir/meta-data"
    else
        die "xorriso, genisoimage or cloud-localds is needed for the cloud-init seed"
    fi
}

write_cloud_init() {
    local role=$1 dir="$RUN/seed-$1" pub
    pub=$(cat "$RUN/id_ed25519.pub")
    mkdir -p "$dir"
    printf 'instance-id: %s-%s\nlocal-hostname: %s-test\n' "$(vm_name "$role")" "$(date +%s)" "$role" > "$dir/meta-data"
    {
        echo "#cloud-config"
        echo "hostname: ${role}-test"
        echo "users:"
        echo "  - name: edutest"
        echo "    sudo: ALL=(ALL) NOPASSWD:ALL"
        echo "    shell: /bin/bash"
        echo "    ssh_authorized_keys: [\"$pub\"]"
        if [[ $role == lmn ]]; then
            # The web installer logs in to the linuxmuster server as root with a password.
            echo "disable_root: false"
            echo "ssh_pwauth: true"
            echo "chpasswd:"
            echo "  expire: false"
            echo "  users:"
            echo "    - {name: root, password: \"$(cat "$RUN/lmn-root-password")\", type: text}"
            echo "write_files:"
            echo "  - path: /etc/ssh/sshd_config.d/60-vm-test-root.conf"
            # A literal \n: YAML turns it into the line break.
            printf '    content: "PermitRootLogin yes\\nPasswordAuthentication yes\\n"\n'
            echo "runcmd:"
            echo "  - [systemctl, restart, ssh]"
        fi
    } > "$dir/user-data"
    cat > "$dir/network-config" <<EOF
version: 2
ethernets:
  nic0:
    match: {macaddress: "$(vm_mac "$role")"}
    set-name: eth0
    addresses: [$(vm_ip "$role")/24]
    routes: [{to: default, via: ${SUBNET}.1}]
    nameservers: {addresses: [${SUBNET}.1]}
EOF
}

domain_xml() {
    local name=$1 memory=$2 mac=$3 seed=$4
    shift 4
    local letters=(a b c d) i=0 vol
    cat <<EOF
<domain type='kvm'>
  <name>$name</name>
  <memory unit='MiB'>$memory</memory>
  <vcpu>2</vcpu>
  <os><type arch='x86_64' machine='q35'>hvm</type><boot dev='hd'/></os>
  <features><acpi/><apic/></features>
  <cpu mode='host-passthrough'/>
  <clock offset='utc'/>
  <devices>
EOF
    for vol in "$@"; do
        printf "    <disk type='volume' device='disk'><driver name='qemu' type='qcow2' discard='unmap'/><source pool='%s' volume='%s'/><target dev='vd%s' bus='virtio'/></disk>\n" \
            "$POOL" "$vol" "${letters[i]}"
        i=$((i + 1))
    done
    cat <<EOF
    <disk type='volume' device='cdrom'><driver name='qemu' type='raw'/><source pool='$POOL' volume='$seed'/><target dev='sda' bus='sata'/><readonly/></disk>
    <interface type='network'><source network='$PREFIX'/><mac address='$mac'/><model type='virtio'/></interface>
    <serial type='pty'/>
    <console type='pty'/>
    <rng model='virtio'><backend model='random'>/dev/urandom</backend></rng>
  </devices>
</domain>
EOF
}

create_volume() {
    local name=$1 size=$2 backing=${3:-}
    if [[ -n $backing ]]; then
        "${V[@]}" vol-create-as "$POOL" "$name" "$size" --format qcow2 \
            --backing-vol "$backing" --backing-vol-format qcow2 > /dev/null
    else
        "${V[@]}" vol-create-as "$POOL" "$name" "$size" --format qcow2 > /dev/null
    fi
    note "Volume $name ($size, thin) in pool $POOL" "virsh -c qemu:///system vol-delete --pool $POOL $name"
}

upload_volume() {
    local name=$1 file=$2 format=$3
    "${V[@]}" vol-create-as "$POOL" "$name" "$(stat -c %s "$file")" --format "$format" > /dev/null
    note "Volume $name in pool $POOL" "virsh -c qemu:///system vol-delete --pool $POOL $name"
    "${V[@]}" vol-upload --pool "$POOL" "$name" "$file"
}

create_vm() {
    local role=$1 memory=$2
    shift 2
    local name seed xml
    name=$(vm_name "$role")
    seed="${name}-seed.iso"
    write_cloud_init "$role"
    make_seed "$RUN/seed-$role" "$RUN/$seed"
    upload_volume "$seed" "$RUN/$seed" raw
    xml="$RUN/$name.xml"
    domain_xml "$name" "$memory" "$(vm_mac "$role")" "$seed" "$@" > "$xml"
    "${V[@]}" define "$xml" > /dev/null
    note "VM $name defined (${memory} MiB, 2 vCPUs, $(vm_ip "$role"))" "virsh -c qemu:///system undefine $name"
    "${V[@]}" start "$name" > /dev/null
    note "VM $name started" "virsh -c qemu:///system destroy $name"
}

wait_for_vm() {
    local role=$1 attempt
    info "Waiting for $(vm_name "$role") ($(vm_ip "$role")) ..."
    for attempt in $(seq 1 60); do
        vm_ssh "$role" true 2> /dev/null && break
        [[ $attempt -lt 60 ]] || die "$(vm_name "$role") does not answer on SSH; console: virsh -c qemu:///system console $(vm_name "$role")"
        sleep 5
    done
    [[ $(vm_ssh "$role" 'sudo cloud-init status --wait > /dev/null 2>&1; cloud-init status') == *"status: done"* ]] \
        || die "cloud-init on $(vm_name "$role") did not finish cleanly: vm-test ssh $role sudo cloud-init status --long"
}

cmd_up() {
    local tool
    for tool in virsh ssh ssh-keygen curl sha256sum ip; do
        command -v "$tool" > /dev/null || die "$tool is missing"
    done
    [[ -e /dev/kvm ]] || die "/dev/kvm is missing, KVM is not available"
    "${V[@]}" pool-info "$POOL" > /dev/null 2>&1 || die "no access to libvirt pool '$POOL' on qemu:///system (group libvirt?)"
    [[ ! -e $RUN ]] || die "an environment exists already ($RUN); remove it with 'vm-test down'"
    [[ -z $(leftovers) ]] || die "libvirt objects named ${PREFIX}* exist already; remove them with 'vm-test down'"
    if ip -4 route | grep -q "^${SUBNET}\."; then
        die "${SUBNET}.0/24 is in use on this host; choose another with VM_TEST_SUBNET"
    fi

    mkdir -p "$STATE" "$CACHE"
    (umask 077 && mkdir "$RUN")
    [[ ! -e $PROTOCOL ]] || mv "$PROTOCOL" "$STATE/protocol-$(date -r "$PROTOCOL" '+%Y%m%d-%H%M%S').md"
    snapshot > "$RUN/baseline.txt"
    {
        echo "# vm-test protocol"
        echo
        echo "Started $(date '+%Y-%m-%d %H:%M:%S %Z'). Every change to the host is listed with the command that undoes it;"
        echo "'vm-test down' undoes all of them."
        echo
        echo "## Host before"
        echo
        echo '```'
        cat "$RUN/baseline.txt"
        echo '```'
        echo
        echo "## Changes"
        echo
        echo "| Time | Change | Undo |"
        echo "|---|---|---|"
    } > "$PROTOCOL"
    trap '[[ $? -eq 0 ]] || info "up did not finish; vm-test down removes what it created (see $PROTOCOL)"' EXIT

    info "Downloading the Ubuntu ${UBUNTU_RELEASE} cloud image (cached in $CACHE) ..."
    curl -fsSL -o "$CACHE/SHA256SUMS" "$IMAGE_BASE_URL/SHA256SUMS"
    if ! (cd "$CACHE" && grep -E " \*?${IMAGE_FILE}\$" SHA256SUMS | sha256sum -c --status 2> /dev/null); then
        curl -fSL --progress-bar -o "$CACHE/$IMAGE_FILE" "$IMAGE_BASE_URL/$IMAGE_FILE"
        (cd "$CACHE" && grep -E " \*?${IMAGE_FILE}\$" SHA256SUMS | sha256sum -c --status) \
            || die "checksum of $IMAGE_FILE does not match"
    fi

    info "Creating volumes ..."
    upload_volume "$BASE_VOL" "$CACHE/$IMAGE_FILE" qcow2
    "${V[@]}" pool-refresh "$POOL" > /dev/null
    create_volume "${PREFIX}-edu.qcow2" 30G "$BASE_VOL"
    create_volume "${PREFIX}-lmn.qcow2" 25G "$BASE_VOL"
    create_volume "${PREFIX}-lmn-data.qcow2" 25G

    info "Creating network $PREFIX (${SUBNET}.0/24, NAT, no DHCP) ..."
    cat > "$RUN/network.xml" <<EOF
<network>
  <name>$PREFIX</name>
  <forward mode='nat'/>
  <bridge name='virbr-$PREFIX' stp='on' delay='0'/>
  <ip address='${SUBNET}.1' netmask='255.255.255.0'/>
</network>
EOF
    "${V[@]}" net-define "$RUN/network.xml" > /dev/null
    note "libvirt network $PREFIX defined (NAT ${SUBNET}.0/24, bridge virbr-$PREFIX)" "virsh -c qemu:///system net-undefine $PREFIX"
    "${V[@]}" net-start "$PREFIX" > /dev/null
    note "libvirt network $PREFIX started (bridge, dnsmasq for DNS, NAT rules)" "virsh -c qemu:///system net-destroy $PREFIX"

    info "Creating VMs ..."
    ssh-keygen -q -t ed25519 -N '' -C vm-test -f "$RUN/id_ed25519"
    (umask 077 && head -c 18 /dev/urandom | base64 | tr -d '/+=' > "$RUN/lmn-root-password")
    create_vm lmn "$LMN_MEMORY" "${PREFIX}-lmn.qcow2" "${PREFIX}-lmn-data.qcow2"
    create_vm edu "$EDU_MEMORY" "${PREFIX}-edu.qcow2"

    wait_for_vm lmn
    wait_for_vm edu
    trap - EXIT
    info "Ready."
    cmd_status
}

cmd_status() {
    [[ -d $RUN ]] || die "no environment, run 'vm-test up' first"
    local role
    for role in edu lmn; do
        printf '%-12s %-12s %s\n' "$(vm_name "$role")" "$(vm_ip "$role")" \
            "$("${V[@]}" domstate "$(vm_name "$role")" 2> /dev/null || echo missing)"
    done
    echo
    echo "linuxmuster server for the web installer: $(vm_ip lmn), user root, password $(cat "$RUN/lmn-root-password")"
    echo "  (after linuxmuster-setup the root password is the admin password entered in the web installer)"
    [[ ! -f $RUN/image-tag ]] || echo "Image built on edu: $(cat "$RUN/image-tag") (vm-test install --local)"
    [[ ! -f $RUN/installer-url ]] || echo "Web installer: $(cat "$RUN/installer-url")"
    echo "Protocol: $PROTOCOL"
}

cmd_build() {
    [[ -d $RUN ]] || die "no environment, run 'vm-test up' first"
    command -v git > /dev/null || die "git is missing"
    local ref=${1:-} commit tag
    if [[ -z $ref ]]; then
        # A commit of the working tree without touching the index or the stash list.
        commit=$(git -C "$REPO_ROOT" stash create)
        commit=${commit:-$(git -C "$REPO_ROOT" rev-parse HEAD)}
        if [[ -n $(git -C "$REPO_ROOT" ls-files --others --exclude-standard) ]]; then
            info "Untracked files are not part of the build; 'git add' them first if they belong to it."
        fi
    else
        commit=$(git -C "$REPO_ROOT" rev-parse --verify "${ref}^{commit}")
    fi
    tag="vmtest-$(git -C "$REPO_ROOT" rev-parse --short "$commit")"

    info "Copying $commit to edu ..."
    git -C "$REPO_ROOT" archive --format=tar "$commit" \
        | vm_ssh edu "sudo rm -rf $SRC_ON_VM && sudo mkdir -p $SRC_ON_VM && sudo tar -x -C $SRC_ON_VM"

    info "Building the web installer and image $tag on edu (takes a few minutes) ..."
    vm_ssh edu "sudo bash -s -- $(printf '%q ' "$SRC_ON_VM" "$NODE_IMAGE" "$tag")" <<'EOF'
set -euo pipefail
src=$1 node_image=$2 tag=$3
if ! command -v docker > /dev/null; then
    # The installer's own way, so it later takes its "Docker is installed" path.
    apt-get update -qq
    apt-get install -y -qq ca-certificates curl gnupg lsb-release > /dev/null
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
        > /etc/apt/sources.list.d/docker.list
    apt-get update -qq
    apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin > /dev/null
fi
docker run --rm -e NX_DAEMON=false -e CI=true -v "$src:/src" -w /src "$node_image" \
    sh -c 'npm ci --no-audit --no-fund --loglevel=error && npx nx build webinstaller'
rm -rf "$src/node_modules"
docker build -q --build-arg INSTALLER_VERSION="$tag" -t "ghcr.io/edulution-io/edulution-installer:$tag" "$src"
EOF
    echo "$tag" > "$RUN/image-tag"
    info "Image ghcr.io/edulution-io/edulution-installer:$tag is ready; start it with 'vm-test install --local'."
}

cmd_install() {
    [[ -d $RUN ]] || die "no environment, run 'vm-test up' first"
    local command tag attempt url=""
    case ${1:-} in
        "")
            command="curl -fsSL https://get.edulution.io/installer -o /root/installer && bash /root/installer"
            ;;
        --version)
            [[ -n ${2:-} ]] || die "--version needs a version, e.g. --version 2.2.3"
            command="curl -fsSL https://get.edulution.io/installer -o /root/installer && bash /root/installer --version $(printf '%q' "$2")"
            ;;
        --local)
            [[ -f $RUN/image-tag ]] || die "no image built, run 'vm-test build' first"
            tag=$(cat "$RUN/image-tag")
            # As in the E2E workflow: the tag exists neither in the registry nor on GitHub, so docker
            # takes the local image and the templates come from the copied checkout.
            command="EDULUTION_TEMPLATE_URL=file://$SRC_ON_VM/apps/public-page/public/download bash $SRC_ON_VM/apps/public-page/public/installer --version $tag"
            ;;
        *) die "unknown option '$1'" ;;
    esac
    if vm_ssh edu 'sudo test -e /root/installer.log'; then
        die "the installer has run on edu already; for a fresh run: vm-test down && vm-test up"
    fi

    info "Starting the installer on edu (log: /root/installer.log) ..."
    vm_ssh edu "sudo bash -s -- $(printf '%q' "$command")" <<'EOF'
setsid nohup bash -c "$1; echo \$? > /root/installer.rc" > /root/installer.log 2>&1 < /dev/null &
EOF
    for attempt in $(seq 1 120); do
        url=$(vm_ssh edu "sudo grep -m1 -oE 'https://$(vm_ip edu):443/\\?token=[0-9a-f]+' /root/installer.log" 2> /dev/null || true)
        [[ -z $url ]] || break
        if vm_ssh edu 'sudo test -e /root/installer.rc' 2> /dev/null; then
            vm_ssh edu 'sudo tail -20 /root/installer.log' >&2 || true
            die "the installer stopped before the web installer came up"
        fi
        [[ $attempt -lt 120 ]] || die "no web installer URL after 20 minutes: vm-test ssh edu sudo tail /root/installer.log"
        sleep 10
    done
    echo "$url" > "$RUN/installer-url"
    echo "Web installer: $url"
    echo "  The certificate is self-signed; accept it in the browser."
    echo "  linuxmuster server: $(vm_ip lmn), user root, password $(cat "$RUN/lmn-root-password")"
}

cmd_down() {
    local keep_image=0 name vol had_protocol=0
    local -a names volumes
    case ${1:-} in
        "") ;;
        --keep-image) keep_image=1 ;;
        *) die "unknown option '$1'" ;;
    esac
    if [[ -f $PROTOCOL ]]; then
        had_protocol=1
        {
            echo
            echo "## Teardown"
            echo
            echo "| Time | Undone |"
            echo "|---|---|"
        } >> "$PROTOCOL"
    fi
    log_down() {
        info "$1"
        [[ $had_protocol -eq 0 ]] || note_teardown "$1"
    }

    mapfile -t names < <("${V[@]}" list --all --name | grep "^${PREFIX}-" || true)
    for name in "${names[@]}"; do
        "${V[@]}" destroy "$name" > /dev/null 2>&1 || true
        "${V[@]}" undefine "$name" > /dev/null
        log_down "VM $name stopped and removed"
    done
    # Overlays before the base image they refer to.
    mapfile -t volumes < <("${V[@]}" vol-list "$POOL" | awk 'NR > 2 && NF { print $1 }' | grep "^${PREFIX}-" \
        | awk -v base="$BASE_VOL" '$0 == base { last = $0; next } { print } END { if (last) print last }' || true)
    for vol in "${volumes[@]}"; do
        "${V[@]}" vol-delete --pool "$POOL" "$vol" > /dev/null
        log_down "Volume $vol deleted"
    done
    if "${V[@]}" net-info "$PREFIX" > /dev/null 2>&1; then
        "${V[@]}" net-destroy "$PREFIX" > /dev/null 2>&1 || true
        "${V[@]}" net-undefine "$PREFIX" > /dev/null
        log_down "Network $PREFIX stopped and removed (bridge, dnsmasq, NAT rules)"
    fi

    local rest
    rest=$(leftovers)
    [[ -z $rest ]] || die "still present: $rest"
    if [[ -f $RUN/baseline.txt ]]; then
        snapshot > "$STATE/after.txt"
        local diff_out
        diff_out=$(diff "$RUN/baseline.txt" "$STATE/after.txt" || true)
        rm -f "$STATE/after.txt"
        if [[ $had_protocol -eq 1 ]]; then
            {
                echo
                echo "## Host after, compared with before"
                echo
                echo '```'
                echo "${diff_out:-no difference}"
                echo '```'
            } >> "$PROTOCOL"
        fi
        if [[ -n $diff_out ]]; then
            info "The host differs from before 'up' (VPN or Docker routes can change on their own):"
            echo "$diff_out" >&2
        else
            info "Host state matches the state before 'up'."
        fi
    fi
    # Key, passwords, cloud-init seeds.
    rm -rf "$RUN"
    [[ $keep_image -eq 1 ]] || rm -rf "$CACHE"
    if [[ $had_protocol -eq 1 ]]; then
        local done_protocol
        done_protocol="$STATE/protocol-$(date '+%Y%m%d-%H%M%S').md"
        mv "$PROTOCOL" "$done_protocol"
        info "Protocol: $done_protocol"
    fi
}

main() {
    local command=${1:-}
    [[ $# -eq 0 ]] || shift
    case $command in
        up) cmd_up ;;
        build) cmd_build "$@" ;;
        install) cmd_install "$@" ;;
        status) cmd_status ;;
        ssh)
            [[ $# -ge 1 ]] || die "ssh needs edu or lmn"
            local role=$1
            shift
            vm_ip "$role" > /dev/null
            if [[ $# -eq 0 ]]; then
                SSH_EXTRA=(-t)
                vm_ssh "$role"
            else
                vm_ssh "$role" "$@"
            fi
            ;;
        down) cmd_down "$@" ;;
        -h | --help | help) usage ;;
        *)
            usage
            exit 2
            ;;
    esac
}

main "$@"
